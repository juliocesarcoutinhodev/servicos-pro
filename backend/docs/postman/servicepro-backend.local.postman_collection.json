    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('rateLimitRemaining', pm.response.headers.get('X-RateLimit-Remaining') || '');",
                  "pm.collectionVariables.set('rateLimitReset', pm.response.headers.get('X-RateLimit-Reset') || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{clientName}}\",\n  \"email\": \"{{clientEmail}}\",\n  \"phone\": \"{{clientPhone}}\",\n  \"password\": \"{{defaultPassword}}\",\n  \"role\": \"CLIENT\"\n}"
            },
            "description": "POST /api/v1/auth/signup",
            "url": "{{baseUrl}}/api/v1/auth/signup"
          },
          "response": []
        },
        {
          "name": "Signup Provider",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('rateLimitRemaining', pm.response.headers.get('X-RateLimit-Remaining') || '');",
                  "pm.collectionVariables.set('rateLimitReset', pm.response.headers.get('X-RateLimit-Reset') || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{providerName}}\",\n  \"email\": \"{{providerEmail}}\",\n  \"phone\": \"{{providerPhone}}\",\n  \"password\": \"{{defaultPassword}}\",\n  \"role\": \"PROVIDER\"\n}"
            },
            "description": "POST /api/v1/auth/signup",
            "url": "{{baseUrl}}/api/v1/auth/signup"
          },
          "response": []
        },
        {
          "name": "Login Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has refresh token cookie', function () {",
                  "  pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(true);",
                  "});",
                  "const data = pm.response.json()?.data;",
                  "if (data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "}",
                  "pm.collectionVariables.set('rateLimitRemaining', pm.response.headers.get('X-RateLimit-Remaining') || '');",
                  "pm.collectionVariables.set('rateLimitReset', pm.response.headers.get('X-RateLimit-Reset') || '');",
                  "pm.collectionVariables.unset('retryAfterSeconds');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{defaultPassword}}\"\n}"
            },
            "description": "POST /api/v1/auth/login",
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has refresh token cookie', function () {",
                  "  pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(true);",
                  "});",
                  "const data = pm.response.json()?.data;",
                  "if (data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "POST /api/v1/auth/refresh (cookie-only)",
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "pm.collectionVariables.set('rateLimitRemaining', pm.response.headers.get('X-RateLimit-Remaining') || '');",
                  "pm.collectionVariables.set('rateLimitReset', pm.response.headers.get('X-RateLimit-Reset') || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\"\n}"
            },
            "description": "POST /api/v1/auth/forgot-password",
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordResetToken}}\",\n  \"newPassword\": \"{{defaultPassword}}\"\n}"
            },
            "description": "POST /api/v1/auth/reset-password",
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "pm.test('Refresh cookie is cleared', function () {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(setCookie).to.include('refresh_token=');",
                  "  pm.expect(setCookie).to.include('Max-Age=0');",
                  "});",
                  "pm.collectionVariables.unset('accessToken');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "POST /api/v1/auth/logout (idempotent, sem Bearer obrigatorio)",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          },
          "response": []
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has user data', function () {",
                  "  const data = pm.response.json()?.data || {};",
                  "  pm.expect(data).to.have.property('id');",
                  "  pm.expect(data).to.have.property('email');",
                  "  pm.expect(data).to.have.property('role');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "GET /api/v1/auth/me",
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "response": []
        }
      ]
    }
  ]
}
