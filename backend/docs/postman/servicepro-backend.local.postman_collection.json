      "name": "Observability",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "description": "GET /actuator/health",
            "url": "{{managementBaseUrl}}/actuator/health"
          },
          "response": []
