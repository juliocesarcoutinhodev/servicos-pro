  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const runId = pm.collectionVariables.get('runId') || Date.now().toString();",
          "pm.collectionVariables.set('runId', runId);",
          "",
          "if (!pm.collectionVariables.get('clientEmail')) {",
          "  pm.collectionVariables.set('clientEmail', `cliente.${runId}@email.com`);",
          "}",
          "",
          "if (!pm.collectionVariables.get('providerEmail')) {",
          "  pm.collectionVariables.set('providerEmail', `prestador.${runId}@email.com`);",
          "}",
          "",
          "if (!pm.collectionVariables.get('clientName')) {",
          "  pm.collectionVariables.set('clientName', 'Cliente Teste');",
          "}",
          "",
          "if (!pm.collectionVariables.get('providerName')) {",
          "  pm.collectionVariables.set('providerName', 'Prestador Teste');",
          "}",
          "",
          "if (!pm.collectionVariables.get('clientPhone')) {",
          "  pm.collectionVariables.set('clientPhone', '+5511999999999');",
          "}",
          "",
          "if (!pm.collectionVariables.get('providerPhone')) {",
          "  pm.collectionVariables.set('providerPhone', '+5511988888888');",
          "}",
          "",
          "if (!pm.collectionVariables.get('defaultPassword')) {",
          "  pm.collectionVariables.set('defaultPassword', 'SenhaForte123');",
          "}",
          "",
          "if (!pm.collectionVariables.get('newCategoryName')) {",
          "  pm.collectionVariables.set('newCategoryName', `Categoria ${runId}`);",
          "}",
          "",
          "if (!pm.collectionVariables.get('newCategoryDescription')) {",
          "  pm.collectionVariables.set('newCategoryDescription', 'Categoria criada via collection');",
          "}"
        ]
      }
    }
  ],
