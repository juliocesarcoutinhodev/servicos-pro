# Copy this file to one of the environment-specific files:
# - .env.local
# - .env.staging
# - .env.production

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081

POSTGRES_DB=servicepro
POSTGRES_USER=servicepro
POSTGRES_PASSWORD=servicepro
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/servicepro
DB_USERNAME=servicepro
DB_PASSWORD=servicepro

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=servicepro
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

AUTH_RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
AUTH_LOGIN_URL=http://localhost:19006/login

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,Origin,Accept
APP_CORS_EXPOSED_HEADERS=X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset,Retry-After
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE_SECONDS=3600

APP_MAIL_ENABLED=false
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_FROM=no-reply@servicepro.app
APP_MAIL_PASSWORD=
APP_MAIL_SMTP_AUTH=true
APP_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_SMTP_SSL_ENABLE=false
APP_MAIL_SMTP_CONNECTIONTIMEOUT=5000
APP_MAIL_SMTP_TIMEOUT=5000
APP_MAIL_SMTP_WRITETIMEOUT=5000
APP_MAIL_DEBUG=false
